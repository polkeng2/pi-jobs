{
  // Spike Worker for issue #2. Later checks (#3, #4, #5) deploy variants of this
  // file under their own `name`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-scout-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Model calls go through this binding only. No API token, no secrets.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "SPIKE", "class_name": "Spike" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Spike"] }],
  "observability": { "enabled": true }
}

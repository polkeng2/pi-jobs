{
  // Test config: no `ai` binding, so nothing here can spend a neuron.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "signal-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Local only; does not enable protection. See docs/spec.md, Cloudflare Access.
  "access": { "dev": { "aud": "signal-dev" } },
  "vars": { "ACCESS_AUD": "signal-dev", "FINNHUB_API_KEY": "fake","EDGAR_CONTACT": "fake@example.invalid" },
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL", "class_name": "Signal" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Signal"] }],
  "kv_namespaces": [{ "binding": "KV" }]
}
